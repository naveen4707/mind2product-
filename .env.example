# ==============================================================================
# FitPlan AI - Environment Variables Template
# Copy this file to .env in your respective frontend or backend folder.
# NEVER place real secrets or service-role keys in this example file or commit .env.
# ==============================================================================

# --- Frontend (.env in frontend/) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# --- Backend (.env in node-backend/) ---
PORT=5000
FASTAPI_URL=http://127.0.0.1:8000
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-optional
